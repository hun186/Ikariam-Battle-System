{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/battle-cases.html",
      "destination": "/battle-cases.html"
    },
    {
      "source": "/battle-cases-model.js",
      "destination": "/battle-cases-model.js"
    },
    {
      "source": "/battle-cases-history.json",
      "destination": "/battle-cases-history.json"
    },
    {
      "source": "/api/simulate",
      "destination": "/api/simulate.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
